# Elastic Beanstalk configuration for the NGS360 MCP Server.
#
# The Procfile runs `ngs360-mcp-server`, which serves stdio unless
# MCP_TRANSPORT says otherwise -- so that variable is what makes the EB
# deployment serve HTTP at all. It is set here rather than per environment
# because it is a property of running under EB, not of a particular tier.
option_settings:
  aws:elasticbeanstalk:application:environment:
    MCP_TRANSPORT: streamable-http
    FASTMCP_HOST: "0.0.0.0"
    FASTMCP_PORT: "8000"
    FASTMCP_STATELESS_HTTP: "true"
    PYTHONPATH: "/var/app/current"

  # The MCP server exposes /health, not the /api/health used by the API server.
  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /health
