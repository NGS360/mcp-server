{
    "class": "CommandLineTool",
    "label": "Example tool for workflow-registration tests",
    "baseCommand": [
        "cp"
    ],
    "inputs": [
        {
            "type": {
                "type": "enum",
                "symbols": [
                    "#main/mode/fast",
                    "#main/mode/safe"
                ]
            },
            "default": "safe",
            "doc": "Copy strategy",
            "id": "#main/mode"
        },
        {
            "type": "File",
            "label": "Source file to copy",
            "inputBinding": {
                "position": 1
            },
            "id": "#main/source_file"
        },
        {
            "type": "string",
            "doc": "Name for the output file",
            "inputBinding": {
                "position": 2
            },
            "id": "#main/target_filename"
        },
        {
            "type": [
                "null",
                "boolean"
            ],
            "doc": "Print each file as it is copied",
            "id": "#main/verbose"
        }
    ],
    "requirements": [
        {
            "class": "InlineJavascriptRequirement"
        }
    ],
    "id": "#main",
    "outputs": [
        {
            "type": "File",
            "doc": "The copy",
            "outputBinding": {
                "glob": "$(inputs.target_filename)"
            },
            "id": "#main/copied_file"
        }
    ],
    "cwlVersion": "v1.2"
}
